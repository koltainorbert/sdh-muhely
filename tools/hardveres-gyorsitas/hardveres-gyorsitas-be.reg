Windows Registry Editor Version 5.00

; SDH Muhely - hardveres gyorsitas kikenyszeritese Chrome es Edge bongeszoben (ceges gepen).
; Futtatas: dupla kattintas, "Igen" - RENDSZERGAZDAKENT. Utana a bongeszo teljes ujrainditasa.
; Visszavonas: hardveres-gyorsitas-vissza.reg

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Google\Chrome]
"HardwareAccelerationModeEnabled"=dword:00000001

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Edge]
"HardwareAccelerationModeEnabled"=dword:00000001
