# A telepítő zipbe (git archive) nem kerülnek be a tesztek – csak a fejlesztéshez kellenek.
/tesztek        export-ignore
/.gitattributes export-ignore
# A mérőpad tesztadat-generátora soha nem kerül a telepítőbe.
/tools/mero-tesztadat.php export-ignore
/tools/mero-meres.php export-ignore
# A forgalmazói központ külön bővítmény (kozpont/sdh-kozpont), nem kerül a vevők telepítőjébe.
/kozpont        export-ignore
/tesztadat      export-ignore
# Az értékesítő webhely (téma, sales, demó) külön csomagok – a Műhely telepítőjébe nem kerülnek.
/weboldal       export-ignore

# A MunkaLap 3 átalakító Windows-parancsfájlja CRLF sorvéggel marad.
/assets/ml3/*.bat -text
/assets/ml3/*.txt -text
/tools/ml3-atalakito export-ignore
