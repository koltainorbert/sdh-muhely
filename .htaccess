# SDH Műhely (0.95.0): a leírások, a forrás-segédletek és az adatfájlok kívülről nem olvashatók.
# Apache 2.4 és 2.2 alatt is; a felület fájljai (CSS, JS, képek, betűk) továbbra is elérhetők.
<FilesMatch "\.(md|txt|py|sh|json|lock|log|sql|gz|jsonl|dist|neon|xml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
Options -Indexes
